node_modules/
dist/
.DS_Store

# Baked voice assets — regenerable via scripts/bake-voices.mjs (~$0.50,
# needs ELEVENLABS_API_KEY). Same convention as docs/seapoint/vo/ in root
# .gitignore: binaries stay out of git; the itch zip carries them.
# Approved takes are archived outside the repo — see docs/game/VOICE_PIPELINE.md.
public/audio/

# Audition references — binary, archived outside git (see VOICE_PIPELINE §7b)
design/auditions/*.mp3

# Trailer + segment videos — large binaries, regenerable via
# scripts/record-run.mjs (+ bake-narration.mjs for the VO). The narration
# script (narration_script.txt) stays tracked as the source; keep a local
# copy of lm_run.mp4 / lm_run_silent.mp4 for the Zoud upload.
game-video/*.mp4
game-video/narration.mp3
